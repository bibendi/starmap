<div class="page-header mb-8">
  <div class="page-header__container">
    <div class="page-header__content">
      <h1 class="page-title"><%= t("admin.assessment_periods.show.title") %></h1>
      <div class="flex items-center gap-3">
        <% if @assessment_period.draft? && policy([:admin, @assessment_period]).activate? %>
          <%= button_to t("admin.assessment_periods.actions.activate"), activate_admin_assessment_period_path(@assessment_period), method: :post, class: "btn btn--primary btn--small" %>
        <% end %>

        <% if @assessment_period.active? && policy([:admin, @assessment_period]).close? %>
          <%= button_to t("admin.assessment_periods.actions.close"), close_admin_assessment_period_path(@assessment_period), method: :post, class: "btn btn--primary btn--small" %>
        <% end %>

        <% if @assessment_period.closed? && policy([:admin, @assessment_period]).archive? %>
          <%= button_to t("admin.assessment_periods.actions.archive"), archive_admin_assessment_period_path(@assessment_period), method: :post, class: "btn btn--small" %>
        <% end %>

        <% if @assessment_period.draft? && policy([:admin, @assessment_period]).edit? %>
          <%= link_to t("admin.assessment_periods.actions.edit"), edit_admin_assessment_period_path(@assessment_period), class: "btn btn--secondary btn--small" %>
        <% end %>

        <% if @assessment_period.draft? && policy([:admin, @assessment_period]).destroy? %>
          <%= button_to t("admin.assessment_periods.actions.delete"), admin_assessment_period_path(@assessment_period), method: :delete, data: {confirm: t("admin.assessment_periods.delete_confirm", default: "Удалить период?")}, class: "btn btn--danger btn--small" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<main class="page-main">
  <div class="flex flex-col gap-8">
    <div class="card">
      <div class="card__body">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100"><%= t("admin.assessment_periods.show.info") %></h2>
          <span class="badge badge--<%= @assessment_period.draft? ? 'secondary' : @assessment_period.active? ? 'success' : @assessment_period.closed? ? 'warning' : 'danger' %>">
            <%= @assessment_period.status %>
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <div class="label mb-1"><%= t("activerecord.attributes.assessment_period.name") %></div>
            <div class="value--large text-gray-900 dark:text-gray-100"><%= @assessment_period.name %></div>
          </div>

          <div>
            <div class="label mb-1"><%= t("admin.assessment_periods.show.dates") %></div>
            <div class="value--medium text-gray-700 dark:text-gray-300">
              <%= l @assessment_period.start_date, format: :short %> - <%= l @assessment_period.end_date, format: :short %>
            </div>
          </div>

          <div>
            <div class="label mb-1"><%= t("admin.assessment_periods.show.evaluation") %></div>
            <div class="value--medium text-gray-700 dark:text-gray-300">
              <%= l @assessment_period.evaluation_start_date, format: :short %> - <%= l @assessment_period.evaluation_end_date, format: :short %>
            </div>
          </div>

          <% if @assessment_period.description.present? %>
            <div class="md:col-span-2">
              <div class="label mb-1"><%= t("admin.assessment_periods.show.description") %></div>
              <div class="text-gray-700 dark:text-gray-300"><%= @assessment_period.description %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card__body">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-6"><%= t("admin.assessment_periods.metrics.title") %></h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div class="text-center p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">
            <div class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-1"><%= @skill_ratings_count %></div>
            <div class="text-sm text-gray-600 dark:text-gray-400"><%= t("admin.assessment_periods.metrics.skill_ratings") %></div>
          </div>

          <div class="text-center p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">
            <div class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-1"><%= @approved_ratings_count %></div>
            <div class="text-sm text-gray-600 dark:text-gray-400"><%= t("admin.assessment_periods.metrics.approved_ratings") %></div>
          </div>

          <div class="text-center p-4 bg-gray-50 dark:bg-gray-800 rounded-lg">
            <div class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-1"><%= @users_with_ratings %></div>
            <div class="text-sm text-gray-600 dark:text-gray-400"><%= t("admin.assessment_periods.metrics.users_with_ratings") %></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
